{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/chika.webp",
    "height": 15,
    "padding": {
      "top": 2,
      "left": 2
    }
  },
  "display": {
    "separator": "  ",
    "size": {
      "binaryPrefix": "jedec"
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "host",
      "key": "",
      "keyColor": "94",
      "format": "{family}"
    },
    {
      "type": "os",
      "key": "",
      "keyColor": "35",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "",
      "keyColor": "32"
    },
    {
      "type": "packages",
      "key": "",
      "keyColor": "33"
    },
    {
      "type": "shell",
      "key": "",
      "keyColor": "36",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "",
      "keyColor": "96",
      "format": "{pretty-name}"
    },
    {
      "type": "wm",
      "key": "",
      "keyColor": "34",
      "format": "{pretty-name}"
    },
    {
      "type": "cursor",
      "key": "󰆿",
      "keyColor": "92",
      "format": "{theme}"
    },
    {
      "type": "terminalfont",
      "key": "",
      "keyColor": "94",
      "format": "{name}"
    },
    {
      "type": "uptime",
      "key": "",
      "keyColor": "93"
    },
        {
      "type": "cpu",
      "key": "",
      "keyColor": "91",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "95",
      "format": "{used} / {total}"
    },
    {
      "type": "command",
      "key": "󰅕",
      "keyColor": "97",
      "text": "echo \"$((($(date +%s)-$(stat -c %W /))/86400)) days\""
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[33m󰮯 \u001b[31m󰊠 \u001b[32m󰊠 \u001b[34m󰊠 \u001b[35m󰊠 \u001b[36m󰊠 \u001b[37m󰊠 \u001b[38m󰊠"
    }
  ]
}
